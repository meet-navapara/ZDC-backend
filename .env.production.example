# ---- zimji Backend — production checklist ----
NODE_ENV=production
PORT=8080

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ZDC

# JWT — use a long random secret (32+ chars) in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated frontend origins allowed by CORS (no trailing slash).
# Include every browser origin that calls this API — custom domain + Vercel:
# CORS_ORIGINS=https://www.zimji.com,https://zimji.com,https://zdc-frontend.vercel.app
CORS_ORIGINS=https://www.zimji.com,https://zimji.com,https://zdc-frontend.vercel.app

# Primary public site URL (also merged into the CORS allowlist)
FRONTEND_URL=https://www.zimji.com

# Behind Render/Railway/Vercel proxy (client IP / rate limits)
TRUST_PROXY=1

B2B_AUTO_APPROVE=false

# Cloudinary (required in production for images)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Optional monitoring
# SENTRY_DSN=
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com

# SMTP for signup OTP emails (required for real OTP delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=zimji <noreply@zimji.com>
SUPPORT_EMAIL=jirani.deal@gmail.com

# Redis cache (optional — Upstash recommended in production)
# REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379

# ---- M-Pesa (Kenya) ----
# MPESA_ENABLED=true
# MPESA_ENV=sandbox
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_CALLBACK_URL=https://zdc-backend.vercel.app/api/payments/mpesa/callback
# MPESA_SANDBOX_AUTO_PAID=false

# ---- Razorpay (India) ----
# RAZORPAY_ENABLED=true
# RAZORPAY_KEY_ID=rzp_live_...
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# FRONTEND_URL=https://zdc-frontend.vercel.app
