# ---- ZDC Backend environment ----
NODE_ENV=development
PORT=8080

# MongoDB connection string (MongoDB Atlas or local)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ZDC

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins.
# In production, ONLY these origins are allowed (e.g. your Vercel URL).
# Example: CORS_ORIGINS=https://zimji.vercel.app,https://www.zimji.com
CORS_ORIGINS=http://localhost:3000

# Number of reverse proxies in front of the app (for correct client IP /
# rate limiting). 0 for local, 1 on Render. Defaults to 1 in production.
TRUST_PROXY=1

# B2B onboarding: "false" (default) = new businesses need Super Admin approval
# before they can operate. Set to "true" to activate new businesses immediately.
B2B_AUTO_APPROVE=false

# Create the first Super Admin with:
#   node scripts/create-admin.mjs <email> <password>
# (or set ADMIN_EMAIL / ADMIN_PASSWORD below and run it with no args)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# ---- Image storage: Cloudinary (required for cloud storage) ----
# Easiest: paste the single CLOUDINARY_URL from your Cloudinary dashboard.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Or set them individually instead of CLOUDINARY_URL:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Local directory used ONLY as a dev fallback when Cloudinary is not configured
FILE_STORAGE_DIR=uploads

# ---- Monitoring & analytics (optional; features no-op if unset) ----
# Sentry error + performance monitoring (Node DSN from your Sentry project)
# SENTRY_DSN=
# PostHog server-side analytics (Project API key + host)
# POSTHOG_API_KEY=phc_s2Kb9T8FmoPHHoQuv5P5czjtiZgLiPJd4sz6YvcmW9xr
# POSTHOG_HOST=https://us.i.posthog.com

# ---- M-Pesa (Safaricom Daraja) — Phase 2; keep DISABLED until STK is wired ----
# ---- M-Pesa Daraja (Phase 2) ----
# Leave MPESA_ENABLED=false for demo stub. Set true + credentials for live STK.
# MPESA_ENABLED=false
# MPESA_ENV=sandbox
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=174379
# MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
# MPESA_CALLBACK_URL=https://YOUR-NGROK.ngrok-free.dev/api/payments/mpesa/callback
# MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Local verify without PIN (sandbox only — never in production):
# MPESA_SANDBOX_AUTO_PAID=true

# ---- Razorpay (India / INR) — Phase 3 ----
# RAZORPAY_ENABLED=false
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ---- Deferred integrations (fill in later) ----
# PERFECTCORP_API_KEY=
# FRONTEND_URL=http://localhost:3000
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# ---- Signup OTP ----
# Mock (default): skip email, fixed code shown in UI
OTP_MOCK=true
MOCK_OTP_CODE=123456
# Real email: set OTP_MOCK=false and fill SMTP_*
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=zimji <noreply@yourdomain.com>
# SUPPORT_EMAIL=jirani.deal@gmail.com
# GOOGLE_MAPS_API_KEY=

# ---- Redis cache (optional; API works without it) ----
# Local Docker (recommended): docker compose up -d  → redis://127.0.0.1:6380
# Note: use 6380 if Windows already has Redis on 6379.
# REDIS_URL=redis://127.0.0.1:6380
# Managed (Upstash / Redis Cloud): paste the redis:// or rediss:// URL
# REDIS_URL=
