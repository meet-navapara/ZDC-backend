# ---- ZDC Backend environment ----
NODE_ENV=development
PORT=8080

# MongoDB connection string (MongoDB Atlas or local)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ZDC

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# ---- Deferred integrations (fill in later) ----
# PERFECTCORP_API_KEY=
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# INTASEND_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
